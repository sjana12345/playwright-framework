    "test:debug": "bddgen && playwright test --debug",
    "profile:list": "tsx scripts/list-profiles.ts",
    "browser:debug": "cmd /c start chrome.exe --remote-debugging-port=9222 --profile-directory=Default",
    "report": "playwright show-report"
