    "test:app3": "bddgen && playwright test --project=App3",
    "test:app1-app3": "bddgen && playwright test --project=App1 --project=App3",
    "test:api": "bddgen && playwright test --grep @api",
    "compare:bulk": "tsx scripts/run-bulk-comparison.ts",
    "generate:csv": "tsx scripts/generate-sample-csv.ts",
