# ========================================================
# CORPORATE LAPTOP / ENTERPRISE CONFIGURATION TEMPLATE
# Copy this file to .env or set these in your terminal / system.
# ========================================================

# 1. Corporate SSL Inspection Bypass (Zscaler, Netskope, Fortinet, Palo Alto)
NODE_TLS_REJECT_UNAUTHORIZED=0

# 2. Corporate Proxy Configuration (leave blank if your laptop uses direct connect or VPN)
# HTTPS_PROXY=http://proxy.yourcompany.com:8080
# HTTP_PROXY=http://proxy.yourcompany.com:8080
# NO_PROXY=localhost,127.0.0.1,*.internal.yourcompany.com,*.staples.com

# 3. Corporate Browser Channel & Profile
# Options: 'chrome' or 'msedge'
BROWSER_CHANNEL=chrome

# Profile name: 'Default', 'Profile 1', 'Profile 2', etc. (Run "npm run profile:list" to view all)
BROWSER_PROFILE=Default

# 4. Persistent Profile Mode (true = retain corporate logins, cookies, and extensions)
USE_PERSISTENT_PROFILE=true

# 5. Remote Debugging Port (CDP) - Attach directly to already open browser
# Launch browser with: npm run browser:debug
CDP_PORT=9222

# 6. Corporate API Authentication (optional Bearer token or API key for protected endpoints)
# API_AUTH_TOKEN=your_oauth_or_jwt_bearer_token
# API_KEY=your_api_key_value
